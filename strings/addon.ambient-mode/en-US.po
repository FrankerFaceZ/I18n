#: /src/ambient-mode/index.js:64
#, icu-message-format, md-text
msgid "setting.entry.addon.ambient-mode.enabled.description"
msgstr ""
"Projects colors from the edges of the video onto the surrounding area, "
"creating an immersive ambient lighting effect similar to YouTube's Ambient "
"Mode. Especially useful on OLED displays — replaces static black letterbox "
"bars with dynamic ambient colors, reducing the risk of permanent burn-in "
"during long streams."

