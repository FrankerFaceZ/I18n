#: /src/modules/main_menu/components/provider.vue:22
#, icu-message-format
msgid "setting.provider.about"
msgstr ""
"Here, you can change the storage provider used by FrankerFaceZ when "
"browsing Twitch. You can try this if you're having a problem with your "
"settings not remaining persistent. Please note that you will need to reload "
"any and all Twitch tabs after changing this."

#: /src/modules/main_menu/components/provider.vue:106
#, icu-message-format
msgid "setting.provider.backup"
msgstr "Yes, I made a backup."

#: /src/settings/providers.ts:1481
#, icu-message-format
msgid "setting.provider.cosb.desc"
msgstr ""
"This provider uses an `<iframe>` to synchronize storage across subdomains. "
"Due to the `<iframe>`, this provider takes longer than others to load, but "
"should perform roughly the same once loaded. You should be using this on "
"non-www subdomains of Twitch unless you don't want your settings to "
"automatically synchronize for some reason."

#: /src/settings/providers.ts:1480
#, icu-message-format
msgid "setting.provider.cosb.title"
msgstr "Cross-Origin Storage Bridge"

#: /src/modules/main_menu/components/provider.vue:56
#, icu-message-format
msgid "setting.provider.cross-origin"
msgstr "(Cross-Origin Compatible)"

#: /src/modules/main_menu/components/provider.vue:58
#, icu-message-format
msgid "setting.provider.cross-origin.about"
msgstr ""
"This means that your settings will work across different domains, "
"subdomains, and embeds."

#: /src/settings/providers.ts:1597
#, icu-message-format
msgid "setting.provider.ext.desc"
msgstr ""
"This provider uses a browser extension service worker to store settings in "
"a location that should not suffer from issues due to storage partitioning "
"or cache clearing."

#: /src/settings/providers.ts:1596
#, icu-message-format
msgid "setting.provider.ext.title"
msgstr "Browser Extension Storage"

